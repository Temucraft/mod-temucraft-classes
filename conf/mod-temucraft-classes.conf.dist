[worldserver]

########################################
# mod-temucraft-classes
########################################
#
#    Temucraft.Reagents.Enable
#        Description: Reagents as a choice. Class spells have their reagents back (portals, Arcane Brilliance, greater
#                     blessings, warlock stones and summons, Rebirth...); with this on, players without reagents
#                     (by their choice or the default) cast them free. 0 = everyone needs the reagents.
#        Default:     1

Temucraft.Reagents.Enable = 1

#
#    Temucraft.Reagents.Default
#        Description: Whether players who never typed .reagents on/off use reagents.
#        Default:     0 - (no reagents needed)
#                     1 - (reagents needed)

Temucraft.Reagents.Default = 0

#
#    Temucraft.Reagents.AllowChoice
#        Description: Players may choose for themselves with .reagents on|off. 0 = Default applies to everyone.
#        Default:     1

Temucraft.Reagents.AllowChoice = 1

#
#    Temucraft.Requirements.Anvil
#    Temucraft.Requirements.Forge
#    Temucraft.Requirements.CookingFire
#    Temucraft.Requirements.OtherFocus
#    Temucraft.Requirements.Tools
#    Temucraft.Requirements.SoulShards
#        Description: Requirements the client's spell data lost, one switch per kind (applied at startup and on
#                     .reload config):
#                       Anvil       smithing recipes need an anvil nearby (also the Black and Icebellow Anvils)
#                       Forge       smelting and forge recipes need a forge nearby (also the Black Forge)
#                       CookingFire cooking recipes need a cooking fire nearby
#                       OtherFocus  alchemy lab, moonwell and altar of shadows recipes
#                       Tools       recipes that need a tool in your bags (Jeweler's Kit, Simple Grinder)
#                       SoulShards  Create Healthstone, Inferno and Soulshatter use a soul shard (with .reagents off
#                                   the reagent choice still makes them free)
#        Default:     1 - required (as in the normal game)
#                     0 - not required (craft anywhere / without the tool or shard)

Temucraft.Requirements.Anvil = 1
Temucraft.Requirements.Forge = 1
Temucraft.Requirements.CookingFire = 1
Temucraft.Requirements.OtherFocus = 1
Temucraft.Requirements.Tools = 1
Temucraft.Requirements.SoulShards = 1

#
#    Temucraft.Talents.Bloom.SpiritPercent
#        Description: Bloom heal when it runs out, in percent of the druid's Spirit.
#        Default:     100

Temucraft.Talents.Bloom.SpiritPercent = 100

#
#    Temucraft.Talents.Bloom.DispelledSpiritPercent
#        Description: Bloom heal when it is dispelled by an enemy, in percent of the druid's Spirit.
#        Default:     50

Temucraft.Talents.Bloom.DispelledSpiritPercent = 50

#
#    Temucraft.Talents.SpearingStrike.Multiplier
#        Description: Damage multiplier of Spearing Strike against mounted targets, giants and dragonkin.
#        Default:     2

Temucraft.Talents.SpearingStrike.Multiplier = 2

#
#    Temucraft.Talents.ArcaneWrath.ManaPercent
#        Description: Extra Arcane Wrath damage, in percent of the caster's maximum mana.
#        Default:     5

Temucraft.Talents.ArcaneWrath.ManaPercent = 5

#
#    Temucraft.Talents.LightsVigil.Range
#        Description: Yards from the target that Light's Vigil also heals party members.
#        Default:     30

Temucraft.Talents.LightsVigil.Range = 30

#
#    Temucraft.Talents.DemonicEnergies.PetManaPercent
#        Description: Pet mana Life Tap restores per Demonic Energies rank, in percent.
#        Default:     10

Temucraft.Talents.DemonicEnergies.PetManaPercent = 10

#
#    Temucraft.Talents.DemonicEnergies.PetHealPercent
#        Description: Warlock damage that heals the pet per Demonic Energies rank, in percent.
#        Default:     4

Temucraft.Talents.DemonicEnergies.PetHealPercent = 4

#
#    Temucraft.Talents.BaneOfHavoc.Range
#        Description: Yards from the warlock that the Bane of Havoc target still takes splash damage.
#        Default:     60

Temucraft.Talents.BaneOfHavoc.Range = 60

#
#    Temucraft.Talents.BaneOfHavoc.SplashPercent
#        Description: Warlock damage copied to the Bane of Havoc target, in percent.
#        Default:     15

Temucraft.Talents.BaneOfHavoc.SplashPercent = 15

#
#    Temucraft.Talents.DemonicBrand.PercentPerRank
#        Description: Extra pet damage against a branded target per Demonic Brand rank, in percent.
#        Default:     10

Temucraft.Talents.DemonicBrand.PercentPerRank = 10

#
#    Temucraft.Talents.LingeringRage.SecondsPerRank
#        Description: Seconds out of combat that rage decay waits per Lingering Rage rank.
#        Default:     2

Temucraft.Talents.LingeringRage.SecondsPerRank = 2
