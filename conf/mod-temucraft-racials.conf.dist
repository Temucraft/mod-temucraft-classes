[worldserver]
########################################
# mod-temucraft-racials
########################################
#
#    Temucraft.Racials.Enable
#        Description: Racials at their best: shorter cooldowns and the strongest versions over the years.
#        Default:     1
#
#    Temucraft.Racials.Cooldowns
#        Description: Shorten the cooldown of every racial (spells ranked "Racial", custom races' included) by
#                     CooldownCut %, never above MaxCooldown nor below MinCooldown seconds (a racial already below
#                     MinCooldown keeps its own). Berserking/Perception/Gift of the Naaru 3 min -> 2, 2 min racials -> 90
#                     sec. CooldownOverrides: "spell:seconds" pairs that win over the rule.
#        Default:     1, 25, 120, 45, "58984:60 20589:60" (Shadowmeld and Escape Artist 1 min)
#
#    Temucraft.Racials.Stoneform
#        Description: Stoneform also removes harmful curses and magic, and cuts damage taken by 10% while it lasts.
#        Default:     1
#
#    Temucraft.Racials.GiftOfTheNaaru
#        Description: Gift of the Naaru heals at least Percent of the target's maximum health.
#        Default:     1 (20%)
#
#    Temucraft.Racials.Hardiness
#        Description: Hardiness (stuns) and Da Voodoo Shuffle (movement impairing effects) shorten them by Percent.
#                     Needs a restart.
#        Default:     1 (20%, stock 15%)
#
#    Temucraft.Racials.HumanSpirit
#        Description: The Human Spirit gives Percent more Spirit. Needs a restart.
#        Default:     1 (10%, stock 3%)
#
#    Temucraft.Racials.Diplomacy
#        Description: Diplomacy also gives Discount % off vendor prices with factions you're Friendly with or better
#                     (ExaltedDiscount % instead at Exalted). Defaults: 1, 5, 25
#                     (on top of the reputation discount; the 10% reputation gain stays).
#        Default:     1 (5%)
#
#    Temucraft.Racials.ExpansiveMind
#        Description: Expansive Mind also raises maximum rage, energy and runic power by Percent.
#        Default:     1 (5%)

Temucraft.Racials.Enable = 1
Temucraft.Racials.Cooldowns = 1
Temucraft.Racials.CooldownCut = 25
Temucraft.Racials.MaxCooldown = 120
Temucraft.Racials.MinCooldown = 45
Temucraft.Racials.CooldownOverrides = "58984:60 20589:60"
Temucraft.Racials.Stoneform = 1
Temucraft.Racials.GiftOfTheNaaru = 1
Temucraft.Racials.GiftOfTheNaaru.Percent = 20
Temucraft.Racials.Hardiness = 1
Temucraft.Racials.Hardiness.Percent = 20
Temucraft.Racials.HumanSpirit = 1
Temucraft.Racials.HumanSpirit.Percent = 10
Temucraft.Racials.Diplomacy = 1
Temucraft.Racials.Diplomacy.Discount = 5
Temucraft.Racials.Diplomacy.ExaltedDiscount = 25
Temucraft.Racials.ExpansiveMind = 1
Temucraft.Racials.ExpansiveMind.Percent = 5

#
#    Temucraft.Racials.BestBonuses
#        Description: Passive racial bonuses at their best: for each race the strongest version of every bonus over
#                     the years (Retail, Classic, TBC/Wrath/Cata/MoP Classic, WoW Forever), the good parts of
#                     different versions combined (Cultivation: +15 Herbalism and +25 Deftness), nothing that was
#                     removed later. Changes existing racials (weapon skill and expertise, resistances equal to your
#                     level, more hit, dodge, stun resistance, ...) and adds the racials the 3.3.5 client never had
#                     (Might of the Mountain, Touch of Elune, Plainsrunning, Jack of All Trades, ... spells
#                     95800-95834, learned with the other racials at creation and at login). The table:
#                     docs/racials.md. 0 = racials as before (the new ones are taken away at login).
#                     Needs a restart. The client's tooltips come with the patch tools/build_racial_bonuses.py makes.
#        Default:     1
#
#    Temucraft.Racials.BestBonuses.ResistancePerLevel
#        Description: Racial resistances (Frost, Nature, Shadow, Arcane, Worgen's Aberration, Blood Elf's Arcane
#                     Resistance) equal to the character's level, as in Cataclysm. 0 = a flat 10, as in Classic.
#                     The 2% less chance to be hit and the 1% less damage taken stay either way. Needs a restart.
#        Default:     1
#
#    Temucraft.Racials.BestBonuses.StunResistChance
#        Description: Hardiness (Orc): chance to resist Stun effects (Classic's 25%), on top of 20% shorter stuns.
#                     0 = none. Needs a restart.
#        Default:     25
#
#    Temucraft.Racials.BestBonuses.PlainsrunningMax
#        Description: Plainsrunning (Tauren): most movement speed, in percent, from moving on foot (2% a second).
#                     WoW Forever: 60 (first 30).
#        Default:     60
#
#    Temucraft.Racials.BestBonuses.EntropicEmbracePeriod
#        Description: Entropic Embrace (Void Elf): while in combat, a roll every this many seconds for the buff
#                     (+5% damage and healing for 12 sec). No rolls out of combat. The tooltip says 15.
#        Default:     15
#
#    Temucraft.Racials.BestBonuses.EntropicEmbraceChance
#        Description: Entropic Embrace: chance of each roll, in percent. The tooltip says 40.
#        Default:     40
#
#    Temucraft.Racials.BestBonuses.EntropicEmbraceGuarantee
#        Description: Entropic Embrace: this roll always succeeds when all the rolls before it in the fight since the
#                     last buff missed (4 = after 3 misses, so with a 15 sec period at least once a minute). The
#                     count of misses starts again when combat ends. 0 = no guarantee, 1 = every roll succeeds.
#        Default:     4

Temucraft.Racials.BestBonuses = 1
Temucraft.Racials.BestBonuses.ResistancePerLevel = 1
Temucraft.Racials.BestBonuses.StunResistChance = 25
Temucraft.Racials.BestBonuses.PlainsrunningMax = 60
Temucraft.Racials.BestBonuses.EntropicEmbracePeriod = 15
Temucraft.Racials.BestBonuses.EntropicEmbraceChance = 40
Temucraft.Racials.BestBonuses.EntropicEmbraceGuarantee = 4

########################################
# mod-temucraft-heritage
########################################
#
#    Temucraft.Heritage.Enable
#        Description: Players may take on the racial traits of another race instead of their own.
#        Default:     1
#
#    Temucraft.Heritage.MinLevel
#        Description: Level from which a player can change their heritage.
#        Default:     10
#
#    Temucraft.Heritage.Cost
#        Description: Price in copper of taking on another race's traits (going back to your own is free).
#        Default:     100000 (10 gold)
#
#    Temucraft.Heritage.CooldownHours
#        Description: Hours before the heritage can be changed again (going back included). 0 = no wait.
#        Default:     24
#
#    Temucraft.Heritage.SameFaction
#        Description: Only races of the player's own faction can be chosen.
#        Default:     0
#
#    Temucraft.Heritage.Bonus.Count
#        Description: How many "second racials" a character may carry on top of their heritage.
#                     The pool is every racial of a race that can't be played on this server.
#                     0 = no second racials.
#        Default:     1
#
#    Temucraft.Heritage.Bonus.Cost
#        Description: Copper to take a second racial (dropping one is free).
#        Default:     100000 (10 gold)
#
#    Temucraft.Heritage.Bonus.Exclude
#        Description: Spell ids kept out of the second-racial pool, comma separated.
#        Default:     ""

Temucraft.Heritage.Enable = 1
Temucraft.Heritage.MinLevel = 10
Temucraft.Heritage.Cost = 100000
Temucraft.Heritage.CooldownHours = 24
Temucraft.Heritage.SameFaction = 0
Temucraft.Heritage.Bonus.Count = 1
Temucraft.Heritage.Bonus.Cost = 100000
Temucraft.Heritage.Bonus.Exclude = ""

#
#    Temucraft.Racials.Stoneform.Percent
#        Description: Stoneform: percent less damage taken while it lasts.
#        Default:     10

Temucraft.Racials.Stoneform.Percent = 10

#
#    Temucraft.Racials.Actives
#        Description: The racial actives (and missing racials) of wow-racials_v3, adapted to 3.3.5: Regeneratin',
#                     Pterrordax Swoop, Embrace of Bwonsamdi, Fireblood, Mole Machine, Ancestral Call, Haymaker, Bag
#                     of Tricks, Make Camp / Return to Camp, Hyper Organic Light Originator, Skeleton Pinkie, Arcane
#                     Pulse, Cantrips, Bull Rush, Light's Judgment, Light's Reckoning, Forge of Light, Spatial Rift,
#                     Quaking Palm, Wing Buffet, Tail Swipe, Soar, Azerite Surge, Quiet Contemplation, Thorn Bloom,
#                     Rootwalking (spells 95835-95876, learned with the racial skill lines; they replace the renamed
#                     stock copies some races had). Their cooldowns are final (Cooldowns above skips them).
#                     0 = the races keep the copies (the new spells are taken away at login). docs/racials.md.
#                     The client's tooltips come with the patch tools/build_racial_actives.py makes.
#        Default:     1

Temucraft.Racials.Actives = 1
